<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.poo.studentmanagement.controller.MainViewController">
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Sistema de Gestão de Estudantes" 
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Demonstração de POO com JavaFX e Persistência de Dados" 
                   style="-fx-font-size: 12px; -fx-text-fill: #ecf0f1;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <!-- Formulário de entrada -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                    <ColumnConstraints minWidth="200" prefWidth="300"/>
                </columnConstraints>
                
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="idField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                           promptText="ID será gerado automaticamente"/>
                
                <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                           promptText="Nome completo do estudante"/>
                
                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                           promptText="email@exemplo.com"/>
                
                <Label text="Data de Nascimento:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <DatePicker fx:id="birthDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                            promptText="Selecione a data"/>
                
                <Label text="Curso:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="courseField" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                           promptText="Nome do curso"/>
                
                <Label text="Média (GPA):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="gpaField" GridPane.columnIndex="1" GridPane.rowIndex="5" 
                           promptText="0.0 a 4.0"/>
            </GridPane>
            
            <!-- Botões de ação -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Adicionar" onAction="#handleAddStudent" 
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="100"/>
                <Button text="Atualizar" onAction="#handleUpdateStudent" 
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="100"/>
                <Button text="Remover" onAction="#handleDeleteStudent" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="100"/>
                <Button text="Limpar" onAction="#handleClearFields" 
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="100"/>
            </HBox>
            
            <!-- Tabela de estudantes -->
            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS" prefHeight="300">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameColumn" text="Nome" prefWidth="150"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="birthDateColumn" text="Data Nasc." prefWidth="100"/>
                    <TableColumn fx:id="enrollmentDateColumn" text="Matrícula" prefWidth="100"/>
                    <TableColumn fx:id="courseColumn" text="Curso" prefWidth="120"/>
                    <TableColumn fx:id="gpaColumn" text="Média" prefWidth="70"/>
                </columns>
            </TableView>
            
            <!-- Status e botões de persistência -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Carregar Dados" onAction="#handleLoadData" 
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="130"/>
                <Button text="Salvar Dados" onAction="#handleSaveData" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"
                        prefWidth="130"/>
                <Label fx:id="statusLabel" text="Pronto" 
                       style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;"/>
            </HBox>
        </VBox>
    </center>
    
    <bottom>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 10;" alignment="CENTER">
            <Label text="© 2024 - Sistema POO com JavaFX | Desenvolvido para demonstrar conceitos de OOP" 
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 10px;"/>
        </HBox>
    </bottom>
</BorderPane>
